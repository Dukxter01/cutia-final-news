# Copiază în .env (local) sau pune valorile în Vercel → Settings → Environment Variables.
# NU scrie chei adevărate în acest fișier: el ajunge pe GitHub.

# Contul de trainer: emailul trainerului (implicit stoichin.radu23@gmail.com) și un cod
# secret de minim 6 caractere, cerut o singură dată, când trainerul își face contul.
# Oricine altcineva își face cont singur și devine student.
TRAINER_EMAILS=
TRAINER_CODE=
# 0 = închide înscrierile noi (după ce s-a înscris clasa)
CUTIA_REGISTRATION=

# Baza de date (obligatoriu pe Vercel): Supabase → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Vercel Cron (briefing-ul zilnic al lui Byte): un șir lung, aleatoriu
CRON_SECRET=

# Opțional
ANTHROPIC_API_KEY=
SESSION_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GITHUB_TOKEN=
